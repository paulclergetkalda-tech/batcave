# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ta_cle_anon_publique
# Clé secrète : sert uniquement à créer les comptes élèves depuis l'espace coach. Ne la partage jamais.
SUPABASE_SERVICE_ROLE_KEY=ta_cle_service_role

# Adresse du site (en local : http://localhost:3000, en ligne : ton domaine)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Lien vers crédIA
NEXT_PUBLIC_CREDIA_URL=https://credia.example
# Fuseau horaire des créneaux d'appel
NEXT_PUBLIC_TIMEZONE=Europe/Paris
